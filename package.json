{
  "name": "micrographic-skill",
  "version": "1.1.0",
  "description": "Micrographic UI design skill for AI coding agents — Cursor, Claude Code, Codex, and more. Also ships as a DESIGN.md.",
  "keywords": [
    "skill",
    "design",
    "design-md",
    "design-tokens",
    "micrographic",
    "cursor",
    "claude",
    "ai-agent",
    "ui",
    "css"
  ],
  "license": "MIT",
  "author": "Alberto González <alberto@resiz.es>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albegosu/micrographic-skill.git"
  },
  "homepage": "https://github.com/albegosu/micrographic-skill#readme",
  "bugs": {
    "url": "https://github.com/albegosu/micrographic-skill/issues"
  },
  "type": "module",
  "scripts": {
    "build:header": "node scripts/build-header.mjs",
    "check:design": "node scripts/check-design-md.mjs",
    "lint:design": "designmd lint DESIGN.md",
    "test": "npm run check:design",
    "prepack": "npm run build:header && npm run check:design",
    "screenshot:eval": "node scripts/screenshot-eval.mjs",
    "screenshot:design-md": "node scripts/screenshot-eval.mjs examples/design-md-spec-card.html \"#design-md-example\"",
    "release:patch": "npm version patch -m 'chore(release): %s'",
    "release:minor": "npm version minor -m 'chore(release): %s'",
    "release:major": "npm version major -m 'chore(release): %s'"
  },
  "bin": {
    "micrographic-skill": "bin/install.mjs"
  },
  "files": [
    "bin/",
    "rules/",
    "SKILL.md",
    "DESIGN.md",
    "EVAL.md",
    "README.md",
    "LICENSE",
    "assets/header.svg",
    "assets/header-data.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "playwright": "^1.60.0",
    "yaml": "^2.9.1"
  }
}
